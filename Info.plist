<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Lotta</string>
	<!-- Keep playing with the screen locked / app in background -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Save lyric cards to Photos -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Lotta guarda en tu galería las tarjetas de letras que creas.</string>
	<!-- Jellyfin servers on the LAN often use plain http:// -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Lotta se conecta a tu servidor Jellyfin en tu red local.</string>
</dict>
</plist>
